{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/guild-state.js": {
      "maxDuration": 90
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/docs-site/control"
    },
    {
      "source": "/control",
      "destination": "/docs-site/control"
    },
    {
      "source": "/control/(.*)",
      "destination": "/docs-site/control"
    },
    {
      "source": "/commands",
      "destination": "/docs-site/commands"
    },
    {
      "source": "/handbook",
      "destination": "/docs-site/index"
    },
    {
      "source": "/(.*)",
      "destination": "/docs-site/$1"
    }
  ]
}
