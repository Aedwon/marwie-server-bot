{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/guild-state.js": {
      "maxDuration": 90
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/docs-site/index"
    },
    {
      "source": "/commands",
      "destination": "/docs-site/commands"
    },
    {
      "source": "/control.js",
      "destination": "/docs-site/control-polish.js"
    },
    {
      "source": "/control-core.js",
      "destination": "/docs-site/control.js"
    },
    {
      "source": "/(.*)",
      "destination": "/docs-site/$1"
    }
  ]
}
